# Backend Environment Variables
# Copy this file to .env for local development

# Node Environment
NODE_ENV=development

# Server Port
PORT=3001

# MongoDB Connection String (MongoDB Atlas)
# Get your connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ricebook?retryWrites=true&w=majority

# Cloudinary Configuration
# Get your Cloudinary URL from Cloudinary dashboard
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Session Secret (use a long random string in production)
SESSION_SECRET=your-secure-session-secret-here

# Frontend URL for CORS (set this to your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app
